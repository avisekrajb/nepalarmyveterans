  "faqs": [
    {
      "question": "संघमा कसरी सदस्य बन्न सकिन्छ?",
      "answer": "नेपाली सेनाबाट अवकाश प्राप्त सैनिकहरूले संघको सदस्यता लिन सक्नुहुन्छ। सदस्यता शुल्क रु. १,०००/- (५ वर्षको लागि) हो।"
    },
    {
      "question": "सदस्यता लिएको के फाइदा हुन्छ?",
      "answer": "सदस्यहरूले सहायता सेवाहरू, कल्याणकारी कार्यक्रमहरू, सञ्जाल अवसरहरू, र संघको गतिविधिहरूमा सहभागी हुन पाउँछन्।"
    },
    {
      "question": "संघले कस्ता सेवाहरू प्रदान गर्दछ?",
      "answer": "सामाजिक कल्याण कार्यक्रम, भूपू सैनिक सहायता, विपद् प्रतिकार्य, सीप विकास, स्वास्थ्य शिविर, रक्तदान अभियान, र सामुदायिक विकास कार्यक्रमहरू।"
    },
    {
      "question": "संघको कार्यालय कहाँ छ?",
