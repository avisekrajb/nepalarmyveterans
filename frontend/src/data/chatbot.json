  "history": {
    "founded": "२०४७ BS",
    "registered": "२०७५ BS",
    "description": "नेपाल राष्ट्रिय भूतपूर्व सैनिक संघ नेपाली सेनाबाट अवकाश प्राप्त गरेका भूतपूर्व सैनिकहरू र तिनका परिवारहरूको कल्याण र देश र सेना प्रति पूर्ण आस्था र निष्ठा सहित देश र जनताको रक्षा र सेवा जस्तो मूलभूत आदर्श र लक्ष्य सहित २०४७ सालमा एक विशुद्ध सामाजिक संस्थाको रूपमा स्थापना भई २०७५ सालमा विधिवत् दर्ता भएको हो।",
    "keyMilestones": [
      { "year": "२०४७", "title": "Foundation", "description": "संस्थाको स्थापना ५० सदस्यहरूको साथ भयो।" },
      { "year": "२०७१", "title": "First Convention", "description": "काठमाडौंमा पहिलो राष्ट्रिय सम्मेलन सम्पन्न।" },
      { "year": "२०७२", "title": "Earthquake Relief", "description": "भूकम्प पीडितहरूलाई राहत र पुनर्निर्माण सहायता।" },
      { "year": "२०७५", "title": "International Recognition", "description": "दक्षिण एशियाको अग्रणी भूपू सैनिक संस्थाको रूपमा मान्यता।" }
    ]
  },
